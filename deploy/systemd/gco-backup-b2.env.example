# TEMPLATE ONLY - variable names, no values. The real file lives ONLY on the
# server at /etc/gco-backup-b2.env (root:root, mode 0600), is created by the
# owner with scripts/setup-b2-credentials.sh, and must never be committed.
#
# Use a Backblaze application key restricted to the single backup bucket with
# only the listFiles + writeFiles capabilities (no deleteFiles/readFiles).
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
