# STAGING environment. Copy to .env.staging (never commit it). Every secret must be NEW and different from production.
NODE_ENV=production
GCO_ENVIRONMENT=staging
NEXT_PUBLIC_GCO_ENVIRONMENT=staging
ALLOW_DEV_ADAPTERS=true

# The private staging address (see docs/staging-environment.md) and its realtime socket.
NEXT_PUBLIC_SITE_URL=https://staging.example.com
APP_URL=https://staging.example.com
NEXT_PUBLIC_REALTIME_URL=wss://staging.example.com/realtime
REALTIME_PORT=3201

POSTGRES_USER=gco
POSTGRES_DB=gco
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48   (different from production: tokens and two-factor seeds must not be interchangeable)
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=30

# Fictional data only: the AI provider is the mock and there is no real API key here.
AI_PROVIDER=mock
OPENAI_API_KEY=
FEATURE_AI_SUGGESTIONS=true
FEATURE_AI_MEMORY=true
FEATURE_AUTO_REASSIGNMENT=true
FEATURE_CLIENT_TICKETS=true
FEATURE_EMERGENCY_CONTROLS=true
FEATURE_ADVANCED_ANALYTICS=false
