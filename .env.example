# ---------------------------------------------------------------------------
# GCO environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=GCO

# Database (PostgreSQL - source of truth for message accounting & all core data)
DATABASE_URL=postgresql://gco:gco_dev_password@localhost:5432/gco?schema=public

# Redis (durable queue backend via BullMQ, cache, realtime pub/sub)
REDIS_URL=redis://localhost:6379

# Realtime WebSocket server (workers/realtime-server.ts)
REALTIME_PORT=3001

# Auth
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=30

# AI provider abstraction (see lib/ai/provider.ts)
# AI_PROVIDER = "mock" | "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=8000

# Feature flags (see lib/config/flags.ts) - "true" | "false"
FEATURE_AI_SUGGESTIONS=true
FEATURE_AI_MEMORY=true
FEATURE_AUTO_REASSIGNMENT=true
FEATURE_CLIENT_TICKETS=true
FEATURE_EMERGENCY_CONTROLS=true
FEATURE_ADVANCED_ANALYTICS=false

# Business rule defaults (all overridable per-tenant in DB; these are system defaults)
DEFAULT_OPERATOR_CAPACITY=2
DEFAULT_RESPONSE_SLA_SECONDS=120
DEFAULT_PRICE_PER_MESSAGE_EUR=0.14
DEFAULT_OPERATOR_COST_PER_MESSAGE_EUR=0.06
FOUNDER_REVENUE_SHARE_PERCENT=5

# Webhook signing (per-integration secrets are stored in DB `integrations` table;
# this is the fallback dev secret used by the mock/dev adapter only)
DEV_WEBHOOK_SECRET=replace_with_dev_secret

# Optional: Airtable bridge (legacy, NOT the source of truth - see docs/decisions.md)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_ENABLED=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Object storage (S3-compatible, only needed if media attachments are enabled)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
