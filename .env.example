# ---------------------------------------------------------------------------
# GCO environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=GCO

# Database (PostgreSQL - source of truth for message accounting & all core data)
# POSTGRES_USER/PASSWORD/DB configure the postgres container itself.
# Generate a real password with: openssl rand -base64 24
POSTGRES_USER=gco
POSTGRES_PASSWORD=replace_with_a_real_password
POSTGRES_DB=gco
# DATABASE_URL below is for LOCAL (non-Docker) development only, where
# Postgres runs on the host and "localhost" is correct. Running under
# docker-compose, this value is IGNORED - docker-compose.yml's web/worker/
# realtime services override DATABASE_URL to postgresql://...@postgres:5432/...
# (the service name, not localhost - required, since inside a container
# "localhost" means that container itself, not the sibling postgres
# container) built from the same POSTGRES_USER/PASSWORD/DB above, so the two
# can never drift out of sync. You do not need to edit that override.
DATABASE_URL=postgresql://gco:replace_with_a_real_password@localhost:5432/gco?schema=public

# Redis (durable queue backend via BullMQ, cache, realtime pub/sub)
# Same local-vs-Docker distinction as DATABASE_URL above: this value is for
# local dev; docker-compose.yml overrides it to redis://redis:6379 for the
# web/worker/realtime containers.
REDIS_URL=redis://localhost:6379

# Realtime WebSocket server (workers/realtime-server.ts)
REALTIME_PORT=3001
# Client-side (browser) URL to reach the above - must use NEXT_PUBLIC_ prefix
# to be embedded in the browser bundle. In production this should be a wss://
# URL through your reverse proxy/load balancer, not the raw internal port.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# Auth
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=30

# AI provider abstraction (see lib/ai/provider.ts)
# AI_PROVIDER = "mock" | "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=8000

# Feature flags (see lib/config/flags.ts) - "true" | "false"
FEATURE_AI_SUGGESTIONS=true
FEATURE_AI_MEMORY=true
FEATURE_AUTO_REASSIGNMENT=true
FEATURE_CLIENT_TICKETS=true
FEATURE_EMERGENCY_CONTROLS=true
FEATURE_ADVANCED_ANALYTICS=false

# Business rule defaults (all overridable per-tenant in DB; these are system defaults)
DEFAULT_OPERATOR_CAPACITY=2
DEFAULT_RESPONSE_SLA_SECONDS=120
DEFAULT_PRICE_PER_MESSAGE_EUR=0.14
DEFAULT_OPERATOR_COST_PER_MESSAGE_EUR=0.06
FOUNDER_REVENUE_SHARE_PERCENT=5

# Webhook signing (per-integration secrets are stored in DB `integrations` table;
# this is the fallback dev secret used by the mock/dev adapter only)
DEV_WEBHOOK_SECRET=replace_with_dev_secret

# Optional: Airtable bridge (legacy, NOT the source of truth - see docs/decisions.md)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_ENABLED=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Object storage (S3-compatible, only needed if media attachments are enabled)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Sales CRM: calendar booking ("Book Closing Call"). Calendly only for MVP -
# see lib/integrations/calendar/provider.ts. Leave unset until real Calendly
# credentials exist; the UI shows a "not yet configured" state, never a fake
# booking flow, when this is empty.
CALENDLY_SCHEDULING_URL=

# Public website - absolute base URL used for canonical links, Open Graph
# tags, robots.txt, and sitemap.xml. Defaults to http://localhost:3000 in
# lib/config/site.ts if unset; set this to the real production domain before
# go-live so search engines see correct absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
